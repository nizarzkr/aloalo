# =============================================================================
# Aloalo — modèle de variables d'environnement
# =============================================================================
# COMMENT L'UTILISER :
#   1. Copie ce fichier :  cp .env.example .env.local
#   2. Remplis chaque ligne avec TES propres clés (jamais celles d'un autre).
#   3. Ne committe JAMAIS .env.local — il reste sur ta machine uniquement.
#
# Les valeurs ci-dessous sont des PLACEHOLDERS bidons, pas de vrais secrets.
# =============================================================================

# --- Base de données + Auth : Supabase (Postgres managé, région West EU/Paris) ---
# Crée un projet sur https://supabase.com puis copie ces valeurs depuis
# Project Settings > API. URL et PUBLISHABLE_KEY sont publiques (préfixe NEXT_PUBLIC_).
# SECRET_KEY est privée : elle bypass la sécurité RLS, à garder côté serveur uniquement.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Secret partagé interne pour les routes pipeline (/api/transcribe, /api/analyze) ---
# Vérifie l'en-tête x-aloalo-internal des appels internes (webhooks → transcribe → analyze).
# Ces routes écrivent avec la service key (bypass RLS) et ne sont JAMAIS appelées par le
# front. Génère une valeur aléatoire forte : openssl rand -hex 32
# Vercel : à définir en Production + Preview + Development.
INTERNAL_PIPELINE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Allowlist anti-SSRF pour l'URL audio envoyée à AssemblyAI (optionnel) ---
# Liste CSV de suffixes d'hôte autorisés pour calls.audio_url (défaut : ringover.com).
# À étendre avec le vrai domaine d'hébergement des enregistrements dès qu'on le voit.
# Ex : ringover.com,cdn.ringover.com
AUDIO_URL_ALLOWED_HOSTS=ringover.com

# --- Transcription audio : AssemblyAI (région EU) ---
# https://www.assemblyai.com — clé dans le dashboard.
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Analyse IA : Claude / Anthropic ---
# https://console.anthropic.com — clé commençant par sk-ant-
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Paiement : Stripe (mode test pour le MVP) ---
# https://dashboard.stripe.com — clés API + secret du webhook.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# --- Email transactionnel : Resend ---
# https://resend.com — clé commençant par re_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# --- Téléphonie : Ringover (webhook entrant) ---
# Secret partagé pour vérifier la signature des webhooks Ringover.
RINGOVER_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- URL publique de l'app (liens d'invitation, redirections) ---
# En local : http://localhost:3000 — en prod : l'URL Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Rate limiting : Upstash Redis ---
# https://upstash.com — crée une base Redis, copie l'URL REST + le token.
UPSTASH_REDIS_REST_URL=https://xxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx

# --- Observabilité / suivi des erreurs : Sentry ---
# https://sentry.io — le DSN est public par design ; le AUTH_TOKEN sert au
# build (upload des source maps) et reste privé (surtout côté Vercel).
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxx
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=aloalo
SENTRY_PROJECT=aloalo-slug

# --- Intégration CRM : HubSpot ---
# HUBSPOT_TOKEN_TEST : token de l'app privée HubSpot (environnement de test).
# HUBSPOT_APP_CLIENT_SECRET : vérifie la signature des requêtes entrantes de
# l'App Card HubSpot vers /api/hubspot/card-data.
HUBSPOT_TOKEN_TEST=xxxxxxxxxxxxxxxxxxxx
HUBSPOT_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
